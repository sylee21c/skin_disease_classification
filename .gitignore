*.ipynb

# ==============================================
# 예외: 다음 파일들은 포함 (결과 이미지/CSV)
# ==============================================

# 결과 폴더의 모든 이미지와 CSV는 포함!
!results/**/*.png
!results/**/*.jpg
!results/**/*.csv

# 프로젝트 루트의 결과 이미지도 포함
!roc_comparison_*.png
!auc_comparison_*.png
!*.csv
!confusion_matrix.png

# evaluation_results 폴더도 포함
!evaluation_results/**/*.png
!evaluation_results/**/*.csv
